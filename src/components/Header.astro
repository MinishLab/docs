---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const path = Astro.url.pathname;
const navItems = [
  { label: 'Packages',   href: '/packages/overview/', active: path.startsWith('/packages') },
  { label: 'Playground', href: '/playground/',        active: path.startsWith('/playground') },
  { label: 'Blog',       href: '/blog/',              active: path.startsWith('/blog') },
  { label: 'About',      href: '/about/',             active: path.startsWith('/about') },
];
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
  </div>
  <nav class="mobile-site-nav sl-flex md:sl-hidden" aria-label="Main">
    {navItems.map(({ label, href, active }) => (
      <a href={href} class:list={['nav-link', 'mobile-nav-link', { active }]}>{label}</a>
    ))}
  </nav>
  <nav class="site-nav sl-hidden md:sl-flex" aria-label="Main">
    {navItems.map(({ label, href, active }) => (
      <a href={href} class:list={['nav-link', { active }]}>{label}</a>
    ))}
  </nav>
  <div class="search-wrapper sl-flex print:hidden">
    {shouldRenderSearch && <Search {...Astro.props} />}
  </div>
  <div class="right-group sl-hidden md:sl-flex print:hidden">
    <div class="sl-flex social-icons">
      <SocialIcons {...Astro.props} />
    </div>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
    <LanguageSelect {...Astro.props} />
  </div>
</div>

<script>
  document.querySelectorAll('.theme-toggle').forEach((button) =>
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {}
    }),
  );
</script>

<style>
  /* Stable flex layout — no extra padding (outer <header> already has it) */
  .header {
    align-items: center;
    height: 100%;
    gap: 0.75rem;
  }

  .title-wrapper {
    flex-shrink: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }

  .site-nav {
    flex-shrink: 0;
    margin-inline-start: auto;
    gap: 0.125rem;
    align-items: center;
  }

  .mobile-site-nav {
    flex: 1;
    min-width: 0;
    gap: 0.35rem;
    align-items: center;
    overflow-x: auto;
    padding-inline-end: 0.15rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .mobile-site-nav::-webkit-scrollbar {
    display: none;
  }

  /* Logo alone on the left; nav, search and icons grouped on the right */
  .search-wrapper {
    flex-shrink: 0;
    margin-inline-start: 0.75rem;
  }

  .right-group {
    flex-shrink: 0;
    gap: 1rem;
    align-items: center;
    margin-inline-start: 0.75rem;
  }

  .social-icons {
    gap: 1rem;
    align-items: center;
  }

  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.3);
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.35rem 0.7rem;
    border-radius: 0.35rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }

  .mobile-nav-link {
    flex-shrink: 0;
    font-size: 0.82rem;
    padding: 0.3rem 0.62rem;
  }

  .theme-toggle {
    display: flex;
    padding: 0.25rem;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
  }

  .theme-toggle svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  .nav-link:hover,
  .nav-link.active {
    background-color: rgba(255, 255, 255, 0.18);
    color: white;
    text-decoration: none;
  }
</style>
