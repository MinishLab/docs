---
import Default from '@astrojs/starlight/components/Footer.astro';
import config from 'virtual:starlight/user-config';

const links = (config.social ?? []).map(({ label, href }) => ({ label, href }));
---

<Default {...Astro.props} />
<nav class="site-footer" aria-label="Social">
  <span class="site-footer-brand"><i aria-hidden="true"></i>Minish</span>
  {links.map(({ label, href }) => <a href={href} rel="noopener noreferrer">{label}</a>)}
</nav>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
  }
  .site-footer span {
    margin-inline-end: auto;
    color: var(--sl-color-gray-3);
  }
  .site-footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-footer-brand i {
    width: 1.1rem;
    height: 1.1rem;
    background-color: currentColor;
    mask: url('/logo/minish_mark_viridian.svg') center / contain no-repeat;
  }
  .site-footer a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
